{
  "name": "tipejos",
  "version": "0.2.9",
  "description": "Mascotas de escritorio con los clásicos asistentes de Microsoft Office (Clippy, Merlin, Rover, El Genio...)",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "setup": "node scripts/make-icon.js && node scripts/download-agents.js",
    "download-assets": "node scripts/download-agents.js",
    "defringe": "node scripts/defringe.js",
    "make-icon": "node scripts/make-icon.js",
    "dist": "electron-builder"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.tipejos.desktoppets",
    "productName": "Tipejos",
    "copyright": "Tipejos",
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "compression": "store",
    "publish": [
      {
        "provider": "github",
        "owner": "ivorojas",
        "repo": "tipejos-app",
        "releaseType": "release"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "assets/icon-mac.png",
      "category": "public.app-category.entertainment",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "Tipejos-Mac-${version}.dmg"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tipejos",
      "artifactName": "Tipejos-Setup-${version}.exe"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
